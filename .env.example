# Umesh Kumar Sahoo Portfolio Environment Variables
# Copy this file to .env.local for local development, or add these to your Render Dashboard Environment Variables.

# --- Optional AI Assistant (Gemini) ---
GEMINI_API_KEY=

# --- Optional GitHub Integration ---
# GITHUB_TOKEN=

# --- SMTP Email Notifications for Contact Form ---
# Option A: Gmail (Recommended & simplest)
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Fill in the fields below (do NOT use your main Gmail login password):
SMTP_SERVICE=gmail
SMTP_USER=sahooumesh2003@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_TO=sahooumesh2003@gmail.com

# Option B: Custom SMTP Server (Brevo / Sendinblue / SendGrid / AWS SES)
# Note: On Render Free tier, direct outbound SMTP ports (25, 465, 587) are restricted by Render.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_login
# SMTP_PASS=your_smtp_key
# SMTP_TO=sahooumesh2003@gmail.com
# SMTP_SECURE=false

# Option C: Resend HTTPS API (Works 100% on Render Free tier over port 443, no SMTP ports needed!)
# Sign up free at https://resend.com and grab an API key:
# RESEND_API_KEY=re_123456789

# --- Server Ports ---
PORT=3000
VITE_HMR_PORT=3001
